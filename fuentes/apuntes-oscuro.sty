% ---------------------------------------------------------------------
%  Datos del documento
% ---------------------------------------------------------------------
\newcommand\asignatura[1]{\gdef\@asignatura{#1}}
\newcommand\cabecera[1]{\gdef\@cabecera{#1}}
\asignatura{Ecuaciones Diferenciales}
\cabecera{}

% ---------------------------------------------------------------------
%  Cabeceras y pies
% ---------------------------------------------------------------------
\pagestyle{fancy}
\fancyhf{}
\renewcommand\headrulewidth{0.4pt}
\renewcommand\headrule{{\color{rulec}\hrule height\headrulewidth width\headwidth\vskip-\headrulewidth}}
\fancyhead[LE]{\color{muted}\small\thepage}
\fancyhead[RE]{\color{muted}\small\textsc{\@asignatura}}
\fancyhead[LO]{\color{muted}\small\textsc{\@cabecera}}
\fancyhead[RO]{\color{muted}\small\thepage}
\fancypagestyle{plain}{\fancyhf{}\renewcommand\headrulewidth{0pt}}
\setlength{\headheight}{14pt}

% ---------------------------------------------------------------------
%  Secciones
% ---------------------------------------------------------------------
\titleformat{\section}
  {\normalfont\Large\bfseries\color{fg}}
  {\color{acc}\thesection}{0.9em}{}
  [{\color{rulec}\vspace{2pt}\titlerule[0.5pt]}]
\titleformat{\subsection}
  {\normalfont\large\bfseries\color{fg}}
  {\color{acc}\thesubsection}{0.9em}{}
\titleformat{\subsubsection}
  {\normalfont\normalsize\bfseries\color{fg}}
  {\color{acc}\thesubsubsection}{0.8em}{}
\titlespacing*{\section}{0pt}{3.0ex plus 1ex minus .3ex}{2.0ex plus .3ex}
\titlespacing*{\subsection}{0pt}{2.6ex plus 1ex minus .3ex}{1.4ex plus .2ex}
\titlespacing*{\subsubsection}{0pt}{2.0ex plus .8ex minus .2ex}{1.0ex plus .2ex}

% Índice
\titlecontents{section}[1.6em]{\addvspace{7pt}\bfseries\color{fg}}
  {\contentslabel[\color{acc}\thecontentslabel]{1.6em}}{}
  {\normalfont\color{rulec}\titlerule*[0.6pc]{.}\bfseries\color{acc}\contentspage}
\titlecontents{subsection}[3.9em]{\addvspace{1pt}\small\color{muted}}
  {\contentslabel[\thecontentslabel]{2.3em}}{}
  {\color{rulec}\titlerule*[0.6pc]{.}\color{muted}\contentspage}
\renewcommand\contentsname{Índice}
\setcounter{tocdepth}{2}

% Ecuaciones y figuras numeradas por sección
\numberwithin{equation}{section}
\numberwithin{figure}{section}
\numberwithin{table}{section}
\captionsetup{labelfont={sc,color=acc},textfont={color=muted},
  margin=1.2em,justification=justified,singlelinecheck=true}
\captionsetup[figure]{name=Figura}

% ---------------------------------------------------------------------
%  Listas
% ---------------------------------------------------------------------
\setlist{itemsep=2pt,topsep=4pt}
\setlist[enumerate,1]{label=\textcolor{acc}{\bfseries\arabic*.},leftmargin=1.7em}
\setlist[enumerate,2]{label=\textcolor{lav}{(\alph*)},leftmargin=1.8em}
\setlist[itemize,1]{label={\color{acc}\scriptsize$\blacksquare$},leftmargin=1.4em}
\setlist[itemize,2]{label={\color{lav}\tiny$\blacktriangleright$},leftmargin=1.4em}
\newlist{pasos}{enumerate}{1}
\setlist[pasos]{label=\textcolor{acc}{\bfseries\arabic*.},leftmargin=1.7em,itemsep=4pt,topsep=4pt}

% ---------------------------------------------------------------------
%  Entornos
% ---------------------------------------------------------------------
\newcounter{entorno}[section]
\renewcommand\theentorno{\thesection.\arabic{entorno}}

\tcbset{
  baseoscuro/.style={enhanced,breakable,colback=boxbg,coltext=fg,
    boxrule=0.6pt,arc=1.2pt,left=8pt,right=8pt,top=10pt,bottom=7pt,
    before skip=12pt,after skip=10pt,
    attach boxed title to top left={xshift=8pt,yshift=-7pt},
    boxed title style={colback=boxbg,boxrule=0.5pt,arc=1pt,
      left=4pt,right=4pt,top=1.5pt,bottom=1.5pt},
    fonttitle=\normalfont\small},
}
\newcommand\@tituloentorno[3]{% color, nombre, opcional
  \textcolor{#1}{\textsc{#2~\theentorno}}%
  \if\relax\detokenize{#3}\relax\else\ \textcolor{fg}{\itshape(#3)}\fi}

\NewDocumentEnvironment{definicion}{O{}}
  {\refstepcounter{entorno}%
   \begin{tcolorbox}[baseoscuro,colframe=acc,boxed title style={colframe=acc},
     title={\@tituloentorno{acc}{Definición}{#1}}]\upshape}
  {\end{tcolorbox}}
\NewDocumentEnvironment{proposicion}{O{}}
  {\refstepcounter{entorno}%
   \begin{tcolorbox}[baseoscuro,colframe=lav,boxed title style={colframe=lav},
     title={\@tituloentorno{lav}{Proposición}{#1}}]\itshape}
  {\end{tcolorbox}}
\NewDocumentEnvironment{lema}{O{}}
  {\refstepcounter{entorno}%
   \begin{tcolorbox}[baseoscuro,colframe=lav,boxed title style={colframe=lav},
     title={\@tituloentorno{lav}{Lema}{#1}}]\itshape}
  {\end{tcolorbox}}
\NewDocumentEnvironment{corolario}{O{}}
  {\refstepcounter{entorno}%
   \begin{tcolorbox}[baseoscuro,colframe=lav,boxed title style={colframe=lav},
     title={\@tituloentorno{lav}{Corolario}{#1}}]\itshape}
  {\end{tcolorbox}}
\NewDocumentEnvironment{teorema}{O{}}
  {\refstepcounter{entorno}%
   \begin{tcolorbox}[baseoscuro,colframe=gold,boxed title style={colframe=gold},
     title={\@tituloentorno{gold}{Teorema}{#1}}]\itshape}
  {\end{tcolorbox}}

\NewDocumentEnvironment{demostracion}{O{}}
  {\par\addvspace{6pt}\noindent{\bfseries\itshape Demostración%
     \if\relax\detokenize{#1}\relax\else\ \normalfont\itshape\textcolor{muted}{#1}\fi.}\ \ignorespaces}
  {\par\nobreak\vspace{-2pt}\noindent\hfill\textcolor{muted}{\small$\blacksquare$}\par\addvspace{8pt}}

\NewDocumentEnvironment{observacion}{O{}}
  {\par\addvspace{8pt}\refstepcounter{entorno}\noindent
   {\color{lav}\bfseries\itshape Observación~\theentorno}%
   \if\relax\detokenize{#1}\relax\else\ \textcolor{muted}{(#1)}\fi\textcolor{lav}{.}\ \ignorespaces}
  {\par\addvspace{8pt}}
\NewDocumentEnvironment{ejemplo}{O{}}
  {\par\addvspace{8pt}\refstepcounter{entorno}\noindent
   {\color{acc}\bfseries Ejemplo~\theentorno}%
   \if\relax\detokenize{#1}\relax\else\ \textcolor{muted}{(#1)}\fi\textcolor{acc}{.}\ \ignorespaces}
  {\par\addvspace{8pt}}
\NewDocumentEnvironment{recordatorio}{O{}}
  {\par\addvspace{8pt}\refstepcounter{entorno}\noindent
   {\color{gold}\bfseries\itshape Repaso~\theentorno}%
   \if\relax\detokenize{#1}\relax\else\ \textcolor{muted}{(#1)}\fi\textcolor{gold}{.}\ \ignorespaces}
  {\par\addvspace{8pt}}

\NewDocumentEnvironment{notacion}{O{}}
  {\par\addvspace{8pt}\refstepcounter{entorno}\noindent
   {\color{acc}\bfseries Notación~\theentorno}%
   \if\relax\detokenize{#1}\relax\else\ \textcolor{muted}{(#1)}\fi\textcolor{acc}{.}\ \ignorespaces}
  {\par\addvspace{8pt}}
\NewDocumentEnvironment{justificacion}{}
  {\par\addvspace{6pt}\noindent{\bfseries\itshape Justificación.}\ \ignorespaces}
  {\par\nobreak\vspace{-2pt}\noindent\hfill\textcolor{muted}{\small$\blacksquare$}\par\addvspace{8pt}}

% Problemas del seminario
\newcounter{problema}[section]
\renewcommand\theproblema{\thesection.\arabic{problema}}
\NewDocumentEnvironment{problema}{O{}}
  {\par\addvspace{12pt}\Needspace{9\baselineskip}\refstepcounter{problema}\noindent
   {\color{gold}\bfseries Problema~\theproblema}%
   \if\relax\detokenize{#1}\relax\else\ \textcolor{muted}{(#1)}\fi\textcolor{gold}{.}\ \itshape\ignorespaces}
  {\par\addvspace{4pt}}
\NewDocumentEnvironment{resolucion}{}
  {\par\addvspace{4pt}\noindent{\bfseries\itshape Resolución.}\par\nobreak\vspace{2pt}}
  {\par\nobreak\vspace{-2pt}\noindent\hfill\textcolor{muted}{\small$\blacksquare$}\par\addvspace{8pt}}

% ---------------------------------------------------------------------
%  Numeración fijada a mano (para reproducir la de un documento previo)
%  \fijanum{2.3} antes de un entorno numerado: muestra y referencia 2.3
% ---------------------------------------------------------------------
\let\@numfijo\relax
\newcommand\fijanum[1]{\gdef\@numfijo{#1}}
\renewcommand\theentorno{\ifx\@numfijo\relax\thesection.\arabic{entorno}\else\@numfijo\fi}
\renewcommand\theproblema{\ifx\@numfijo\relax\thesection.\arabic{problema}\else\@numfijo\fi}
\@for\@nombre:={definicion,proposicion,lema,corolario,teorema,observacion,ejemplo,%
  recordatorio,notacion,problema,algoritmo,enunciado}\do{%
  \AddToHook{env/\@nombre/end}{\global\let\@numfijo\relax}}

% Modelo físico (caja con marco celeste, sin número)
\NewDocumentEnvironment{modelo}{m}
  {\begin{tcolorbox}[baseoscuro,colframe=sky,boxed title style={colframe=sky},
     title={\textcolor{sky}{\textsc{Modelo}}\ \textcolor{fg}{\itshape #1}}]\upshape}
  {\end{tcolorbox}}

% Algoritmo con pasos «Paso k.»
\newlist{pasosalg}{enumerate}{1}
\setlist[pasosalg]{label=\textcolor{acc}{\textsc{Paso~\arabic*.}},leftmargin=4.4em,labelsep=0.6em,
  itemsep=3pt,topsep=4pt,align=left}
\newcounter{algoritmo}[section]
\NewDocumentEnvironment{algoritmo}{O{}}
  {\refstepcounter{entorno}%
   \begin{tcolorbox}[enhanced,breakable,colback=boxbg,coltext=fg,frame hidden,
     borderline west={2.2pt}{0pt}{acc},arc=0pt,left=10pt,right=10pt,top=7pt,bottom=7pt,
     before skip=12pt,after skip=12pt]%
   {\textcolor{acc}{\textsc{Algoritmo~\theentorno}}%
    \if\relax\detokenize{#1}\relax\else\ \textcolor{fg}{\itshape(#1)}\fi}\par\vspace{3pt}}
  {\end{tcolorbox}}

% Desarrollo guiado (barra lavanda)
\newtcolorbox{desarrollo}[1]{enhanced,breakable,colback=boxbg,coltext=fg,frame hidden,
  borderline west={2.2pt}{0pt}{lav},arc=0pt,left=10pt,right=10pt,top=7pt,bottom=7pt,
  before skip=12pt,after skip=12pt,
  before upper={\textcolor{lav}{\textsc{Desarrollo}}\ \textcolor{fg}{\itshape #1}\par\vspace{3pt}}}

% Enunciado de problema (barra dorada)
\NewDocumentEnvironment{enunciado}{O{}}
  {\refstepcounter{problema}%
   \begin{tcolorbox}[enhanced,breakable,colback=boxbg,coltext=fg,frame hidden,
     borderline west={2.2pt}{0pt}{gold},arc=0pt,left=10pt,right=10pt,top=6pt,bottom=6pt,
     before skip=8pt,after skip=8pt]%
   {\color{gold}\bfseries Problema~\theproblema}%
   \if\relax\detokenize{#1}\relax\else\ \textcolor{muted}{(#1)}\fi\textcolor{gold}{.}\ \ignorespaces}
  {\end{tcolorbox}}

% Cajas con barra lateral: método, nota, motivación, consejo
\newtcolorbox{metodo}[1]{enhanced,breakable,colback=boxbg,coltext=fg,frame hidden,
  borderline west={2.2pt}{0pt}{acc},arc=0pt,left=10pt,right=10pt,top=7pt,bottom=7pt,
  before skip=12pt,after skip=12pt,
  title={\textcolor{acc}{\textsc{#1}}},coltitle=acc,colbacktitle=boxbg,
  fonttitle=\normalfont,detach title,before upper={\tcbtitle\par\vspace{5pt}}}
\newtcolorbox{nota}[1]{enhanced,breakable,colback=boxbg,coltext=fg,frame hidden,
  borderline west={2.2pt}{0pt}{gold},arc=0pt,left=10pt,right=10pt,top=6pt,bottom=6pt,
  before skip=10pt,after skip=10pt,fontupper=\small,
  before upper={\textcolor{gold}{\textsc{#1}.}\ }}
\newtcolorbox{motivacion}[1]{enhanced,breakable,colback=boxbg,coltext=fg,frame hidden,
  borderline west={2.2pt}{0pt}{acc},arc=0pt,left=10pt,right=10pt,top=6pt,bottom=6pt,
  before skip=10pt,after skip=10pt,fontupper=\small,
  before upper={\textcolor{acc}{\textsc{#1}.}\ }}
\newtcolorbox{consejo}[1]{enhanced,breakable,colback=boxbg,coltext=fg,frame hidden,
  borderline west={2.2pt}{0pt}{lav},arc=0pt,left=10pt,right=10pt,top=6pt,bottom=6pt,
  before skip=10pt,after skip=10pt,fontupper=\small,
  before upper={\textcolor{lav}{\textsc{#1}.}\ }}

% Resultado destacado dentro de una ecuación
\newcommand\res[1]{\tcbhighmath[enhanced,colback=boxbg,colframe=acc,boxrule=0.6pt,
  arc=1pt,left=4pt,right=4pt,top=3pt,bottom=3pt]{\color{fg}#1}}

% Cabecera de resúmenes / formularios
\newcommand\titular[3]{%
  {\centering
   {\color{acc}\small\textls[180]{\textsc{#2}}}\par\vspace{4pt}
   {\LARGE\bfseries #1}\par\vspace{3pt}
   {\color{muted}\itshape\small #3}\par\vspace{4pt}
   {\color{rulec}\rule{\linewidth}{0.5pt}}\par}\vspace{6pt}}

