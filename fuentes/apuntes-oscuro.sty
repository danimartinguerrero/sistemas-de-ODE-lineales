\pgfplotsset{
  oscuro/.style={
    axis lines=middle, axis line style={muted,line width=0.4pt,-{Stealth[length=4pt]}},
    tick style={muted,line width=0.4pt}, major tick length=3pt,
    tick label style={muted,font=\scriptsize},
    label style={fg,font=\small},
    every axis x label/.style={at={(ticklabel* cs:1)},anchor=west,font=\small},
    every axis y label/.style={at={(ticklabel* cs:1)},anchor=south,font=\small},
    grid=none, clip=true, legend style={draw=none,fill=none,text=fg,font=\scriptsize},
    every axis plot/.append style={line width=0.85pt},
    samples=200, smooth,
  },
  caja/.style={
    axis lines=box, axis line style={muted,line width=0.4pt},
